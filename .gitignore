## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/
.vscode/
.idea/

# Test Results
TestResults/
*.VisualState.xml
TestResult.xml
nunit-*.xml

# .NET Core
project.lock.json
project.fragment.lock.json
project.assets.json
artifacts/
artifactsobj/
*.nuget.dgspec.json
*.nuget.g.props
*.nuget.g.targets
artifactsobj/
*.nuget.dgspec.json
*.nuget.g.props
*.nuget.g.targets

# Files built by Visual Studio
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Code coverage results
*.coverage
*.coveragexml
coverage*/
*.sarif

# NuGet Packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Visual Studio cache files
*.[Cc]ache
!?*.[Cc]ache/

# SQL Server files
*.mdf
*.ldf
*.ndf

# Node.js
node_modules/

# JetBrains Rider
*.sln.iml

# Environment files with secrets
appsettings.Development.json
appsettings.Production.json
appsettings.Local.json
appsettings.*.json
!appsettings.json
!LgymApi.E2ETests/appsettings.E2E.json
appsettings.container.json
appsettings.*.container.json
appsettings.secrets.json
*.local.secrets.json
!appsettings.container.example.json

# Standalone E2E private runtime and browser artifacts
/.e2e-private/
LgymApi.E2ETests/.playwright/
LgymApi.E2ETests/ms-playwright/
LgymApi.E2ETests/playwright-report/
LgymApi.E2ETests/test-results/
LgymApi.E2ETests/traces/
LgymApi.E2ETests/screenshots/
LgymApi.E2ETests/reports/
LgymApi.E2ETests/runtime/

# .env files
.env
.env.local
.env.development
.env.production
!.env.example

# Local runtime/storage artifacts
dev-photo-storage/
EmailOutbox/

# OS files
.DS_Store
Thumbs.db

# Windows reserved filenames (created accidentally)
nul

# Local deployment helper
deploy.sh

# Sisyphus orchestration artifacts
.sisyphus/
**/.sisyphus/
.evidence/
**/.evidence/
.omo

# Runtime secrets (PRIVATE TLS keys) - NEVER commit to public repos
runtime-secrets/

# Playwright MCP session artifacts (tool noise, not source)
.playwright-mcp/

# Ad-hoc QA evidence screenshots/logs (not part of source)
task-f3-*.png
task-f3-*.md
